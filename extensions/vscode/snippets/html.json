  "Web Expressive Starter": {
    "prefix": ["!we", "web-expressive-starter"],
    "body": [
      "<!doctype html>",
      "<html lang=\"en\">",
      "  <head>",
      "    <meta charset=\"UTF-8\" />",
      "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
      "    <title>${1:Web Expressive Starter}</title>",
      "",
      "    <!-- 1. Typography -->",
      "    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />",
      "    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />",
      "    <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Roboto+Flex:wght@400..700&display=swap\" />",
      "",
      "    <!-- 2. Core (reset + tokens) -->",
      "    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/web-expressive@1.1.0/dist/core.css\" />",
      "",
      "    <!-- 3. A color scheme -->",
      "    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/web-expressive@1.1.0/dist/schemes/alpha/${2|baseline,monochrome,aqua-tonal,berry-tonal,classic-tonal,forest-tonal,fuchsia-tonal,paper-tonal,porcelain-tonal,sun-tonal|}.css\" />",
      "",
      "    <!-- 4. Components (as needed) -->",
      "    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/web-expressive@1.1.0/dist/components/button.css\" />",
      "",
      "    <style>",
      "      html {",
      "        --ref-typeface-base: \"Roboto Flex\";",
      "      }",
      "      .headline {",
      "        font: var(--sys-typescale-headline-large);",
      "      }",
      "    </style>",
      "  </head>",
      "  <body>",
      "    <h1 class=\"headline\">Hello, World!$0</h1>",
      "    <button class=\"button tonal large\">Get Started</button>",
      "  </body>",
      "</html>"
    ],
    "description": "Complete HTML starter template loading Web Expressive (typography, core reset, scheme, button) via CDN."
  },
