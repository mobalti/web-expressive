{
  "Component: Button": {
    "name": "Component: Button",
    "prefix": [
      "we-button",
      "button"
    ],
    "body": [
      "<button class=\"button ${1|filled,tonal,outline,elevated,text|}\">$2</button>$0"
    ],
    "description": "Buttons communicate actions across dialogs, modals, forms, cards, and toolbars.\nVariants: filled (default) | tonal | outline | elevated | text\nSizes: extra-small | small (default) | medium | large | extra-large\nShapes: round (default) | square"
  },
  "Component: Button Link": {
    "name": "Component: Button Link",
    "prefix": [
      "we-button:a",
      "button:a"
    ],
    "body": [
      "<a class=\"button ${1|filled,tonal,outline,elevated,text|}\" href=\"$2\">$3</a>$0"
    ],
    "description": "Buttons communicate actions across dialogs, modals, forms, cards, and toolbars.\nVariants: filled (default) | tonal | outline | elevated | text\nSizes: extra-small | small (default) | medium | large | extra-large\nShapes: round (default) | square"
  },
  "Component: Toggle Button": {
    "name": "Component: Toggle Button",
    "prefix": [
      "we-toggle-button",
      "toggle-button"
    ],
    "body": [
      "<div class=\"toggle-button ${1|filled,tonal,outline,elevated|}\">",
      "  <input class=\"input\" type=\"${2|checkbox,radio|}\" name=\"$3\" id=\"$4\">",
      "  <label class=\"label\" for=\"$4\">$0</label>",
      "</div>"
    ],
    "description": "Toggle a choice on or off, or select an option using a native checkbox or radio.\nVariants: filled (default) | tonal | outline | elevated\nSizes: extra-small | small (default) | medium | large | extra-large\nShapes: round (default) | square"
  },
  "Component: Icon Button": {
    "name": "Component: Icon Button",
    "prefix": [
      "we-icon-button",
      "icon-button"
    ],
    "body": [
      "<button class=\"icon-button ${1|filled,tonal,outline,standard|}\" aria-label=\"$2\">",
      "  <span class=\"icon\" aria-hidden=\"true\">$3</span>",
      "</button>$0"
    ],
    "description": "Compact button for supplementary actions. Always include an aria-label.\nVariants: filled (default) | tonal | outline | standard\nSizes: extra-small | small (default) | medium | large | extra-large\nShapes: round (default) | square\nWidths: narrow | normal (default) | wide"
  },
  "Component: Icon Button Link": {
    "name": "Component: Icon Button Link",
    "prefix": [
      "we-icon-button:a",
      "icon-button:a"
    ],
    "body": [
      "<a class=\"icon-button ${1|filled,tonal,outline,standard|}\" href=\"$2\" aria-label=\"$3\">",
      "  <span class=\"icon\" aria-hidden=\"true\">$4</span>",
      "</a>$0"
    ],
    "description": "Compact button for supplementary actions. Always include an aria-label.\nVariants: filled (default) | tonal | outline | standard\nSizes: extra-small | small (default) | medium | large | extra-large\nShapes: round (default) | square\nWidths: narrow | normal (default) | wide"
  },
  "Component: Toggle Icon Button": {
    "name": "Component: Toggle Icon Button",
    "prefix": [
      "we-toggle-icon-button",
      "toggle-icon-button"
    ],
    "body": [
      "<div class=\"toggle-icon-button ${1|filled,tonal,outline,standard|}\">",
      "  <input class=\"input\" type=\"${2|checkbox,radio|}\" name=\"$3\" id=\"$4\" aria-label=\"$5\">",
      "  <label class=\"label\" for=\"$4\">",
      "    <span class=\"icon\" aria-hidden=\"true\">$6</span>",
      "  </label>",
      "</div>$0"
    ],
    "description": "Toggle an icon state using a native checkbox or radio. Always include an aria-label.\nVariants: filled (default) | tonal | outline | standard\nSizes: extra-small | small (default) | medium | large | extra-large\nShapes: round (default) | square\nWidths: narrow | normal (default) | wide"
  },
  "Component: Standard Button Group": {
    "name": "Component: Standard Button Group",
    "prefix": [
      "we-standard-button-group",
      "standard-button-group"
    ],
    "body": [
      "<div class=\"standard-button-group $1\" role=\"group\" aria-label=\"$2\">",
      "  $0",
      "</div>"
    ],
    "description": "Groups related buttons with interactive layout response.\nSizes: extra-small | small (default) | medium | large | extra-large\nShapes: round (default) | square\nWidths: narrow | normal (default) | wide"
  },
  "Component: Connected Button Group": {
    "name": "Component: Connected Button Group",
    "prefix": [
      "we-connected-button-group",
      "connected-button-group"
    ],
    "body": [
      "<div class=\"connected-button-group $1\" role=\"group\" aria-label=\"$2\">",
      "  $0",
      "</div>"
    ],
    "description": "Groups related toggle options into a unified segmented strip.\nSizes: extra-small | small (default) | medium | large | extra-large\nShapes: round (default) | square"
  },
  "Component: Extended FAB": {
    "name": "Component: Extended FAB",
    "prefix": [
      "we-extended-fab",
      "extended-fab"
    ],
